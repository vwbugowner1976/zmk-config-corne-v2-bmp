#!/usr/bin/env bash
set -u -o pipefail

TARGET="${1:-all}"
PROJECT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_NAME="zmk-config-corne-v2-bmp"
AI_DIR="$PROJECT_DIR/.ai"
TIMESTAMP="$(date '+%Y%m%d-%H%M%S')"
LOG_FILE="$AI_DIR/build-${TIMESTAMP}.log"
CONTEXT_FILE="$AI_DIR/context-${TIMESTAMP}.txt"
LATEST_CONTEXT="$AI_DIR/latest-context.txt"
LOCAL_ANALYSIS="$AI_DIR/local-analysis.txt"
SHARE_LATEST="$AI_DIR/share-latest.txt"

# GitHub Contents API updates can drop executable bits. Repair related helpers
# whenever ai-build is launched (including via `bash ./ai-build left`).
chmod +x \
    "$PROJECT_DIR/ai-build" \
    "$PROJECT_DIR/ai-share" \
    "$PROJECT_DIR/build-local.sh" \
    "$PROJECT_DIR/setup-lighting-workspace.sh" \
    2>/dev/null || true

mkdir -p "$AI_DIR"

case "$TARGET" in
    all|left|right|led-test-left|led-test-right|reset) ;;
    *)
        echo "Usage: $0 [all|left|right|led-test-left|led-test-right|reset]" >&2
        exit 2
        ;;
esac

echo "[ai-build] project=$PROJECT_NAME target=$TARGET"
echo "[ai-build] log=$LOG_FILE"
echo

set +e
bash "$PROJECT_DIR/build-local.sh" "$TARGET" 2>&1 | tee "$LOG_FILE"
BUILD_RC=${PIPESTATUS[0]}
set -e

if [[ $BUILD_RC -eq 0 ]]; then
    BUILD_STATUS="SUCCESS"
else
    BUILD_STATUS="FAILED"
fi

ERROR_LINES="$(grep -nEi '(^|[^[:alpha:]])(error|fatal|failed|failure)([^[:alpha:]]|$)|CMake Error|ninja: build stopped|undefined reference|west: unknown command|workspace not found' "$LOG_FILE" | tail -n 80 || true)"

if [[ -z "$ERROR_LINES" ]]; then
    ERROR_LINES="(no matching error lines)"
fi

{
    echo "PROJECT: $PROJECT_NAME"
    echo "TARGET: $TARGET"
    echo "TIMESTAMP: $TIMESTAMP"
    echo "STATUS: $BUILD_STATUS"
    echo "EXIT_CODE: $BUILD_RC"
    echo

    echo "PROJECT_GIT:"
    git -C "$PROJECT_DIR" rev-parse --short HEAD 2>/dev/null || true
    git -C "$PROJECT_DIR" status --short 2>/dev/null || true
    echo

    echo "ZMK_GIT:"
    if [[ -d "$HOME/zmk-dev/corne-v2-bmp-v03/zmk/.git" ]]; then
        git -C "$HOME/zmk-dev/corne-v2-bmp-v03/zmk" describe --tags --always --dirty 2>/dev/null || true
        git -C "$HOME/zmk-dev/corne-v2-bmp-v03/zmk" rev-parse --short HEAD 2>/dev/null || true
    elif [[ -d "$HOME/zmk-dev/v0.3/zmk/.git" ]]; then
        git -C "$HOME/zmk-dev/v0.3/zmk" describe --tags --always --dirty 2>/dev/null || true
        git -C "$HOME/zmk-dev/v0.3/zmk" rev-parse --short HEAD 2>/dev/null || true
    else
        echo "(ZMK repo not found)"
    fi
    echo

    echo "ERROR_SUMMARY:"
    printf '%s\n' "$ERROR_LINES"
    echo

    echo "UF2_ARTIFACTS:"
    find "$HOME/zmk-dev/corne-v2-bmp-v03/build/corne-v2-bmp" "$HOME/zmk-dev/v0.3/build/corne-v2-bmp" \
        -type f -name '*.uf2' -printf '%p\n' 2>/dev/null | sort || true
    echo

    echo "BUILD_LOG_TAIL:"
    tail -n 160 "$LOG_FILE" || true
} > "$CONTEXT_FILE"

cp -f "$CONTEXT_FILE" "$LATEST_CONTEXT"

{
    echo "LOCAL_ANALYSIS:"
    echo "PROJECT: $PROJECT_NAME"
    echo "TARGET: $TARGET"
    echo "RESULT: $BUILD_STATUS"
    echo "EXIT_CODE: $BUILD_RC"
    echo
    echo "PRIMARY_ERROR_LINES:"
    printf '%s\n' "$ERROR_LINES" | head -n 40
} > "$LOCAL_ANALYSIS"

{
    cat "$LATEST_CONTEXT"
    echo
    echo "============================================================"
    cat "$LOCAL_ANALYSIS"
} > "$SHARE_LATEST"

if bash "$PROJECT_DIR/ai-share" "$TIMESTAMP"; then
    :
else
    echo "[ai-build] WARNING: Windows txt copy failed, but local context was created." >&2
fi

echo
echo "[ai-build] status=$BUILD_STATUS exit=$BUILD_RC"
echo "[ai-build] context=$LATEST_CONTEXT"
echo "[ai-build] share=$SHARE_LATEST"

exit "$BUILD_RC"
